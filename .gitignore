# ---- AI-OS build artifacts (host runtime) ----
source/*.o
source/*.d
source/*.a
source/build/
source/aiosh
source/aios-demo
source/aios-memctl
source/aios-governor
source/aios-desktop
source/tool-exec
*.o
*.d
*.a

# ---- boot image build tree (regenerated by boot/fetch.sh + make) ----
source/boot/build/
# kern-dev/ is EXTRACTED from the committed boot/dl/linux-virt-dev.apk by
# fetch.sh: derived, 1000+ files, and it would double the repo's header tree.
# Ignoring it keeps fetch.sh offline (the apk ships) without the extract.
source/boot/dl/kern-dev/
# NOTE: source/boot/dl/ is already committed (fetch.sh output). It stays tracked
# so the image builds offline; remove it from CI checkouts instead of ignoring
# it here, which would silently hide re-fetched kernel/modules changes.
source/boot/module/*.ko
source/boot/module/*.o
source/boot/module/.tmp_versions/
source/boot/module/Module.symvers
source/boot/module/modules.order
source/boot/module/*.mod.c
source/boot/module/*.mod
source/boot/module/.*.cmd
source/boot/.m10-size-cap

# ---- release bundle: GENERATED, never committed ----
# The repo keeps exactly one copy of each binary (source/boot/dl/). The flat
# no-toolchain bundle that INSTALL.md describes is built on demand by
# source/tools/make-release-bundle.sh; committing it duplicated the 10.8 MB
# kernel and an 8 MB data.img.
vmlinuz-virt
aios-initramfs.cpio.xz
data.img
source/dist/

# ---- runtime state (the OS owns it, never the repo) ----
.aios-store/
source/.aios-store/
*.log

# ---- python ----
__pycache__/
*.pyc
.venv/
