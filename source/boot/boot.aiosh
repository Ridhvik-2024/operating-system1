# /etc/aios/boot.aiosh — AI-OS system bring-up, executed by aios-init
# through aiosh (the AI-native shell) at every boot. The shell runs in
# MICRO mode (M7): the OS's own tiny language model classifies and speaks
# here — LLM-first boot, fully deterministic, no network.
version
echo boot: micro-lm cortex check
lm classify run the nightly report in the background at idle priority
lm gen about the scheduler
echo boot: verifying tools
6*7
echo boot: verifying memory
remember AI-OS v1.0 boot completed
recall AI-OS v1.0
echo boot: natural language routing (background class)
later, summarize the workspace notes
wait all
jobs
echo boot: durable state (M8 ext2 side disk)
dur
echo boot: publishing on sembus
emit boot.up '{"milestone":"v1.0","status":"services.up"}'
echo boot: kernel bridge status
kernel
echo boot: autopilot governor status
autopilot
echo boot: rollback proof (M5)
# The proof runs in the shell so it exercises exactly what a human would type:
# write, snapshot, wreck, roll back, and read the file back. boot-test.sh then
# asserts the FIRST content after a REBOOT, which is the part that proves the
# snapshot was on disk rather than in a variable.
snap take boot-proof
fs.write path=bootproof.txt content=v1
snap take before-wreck
fs.write path=bootproof.txt content=v2
rollback latest
fs.read path=bootproof.txt
echo boot: audit chain proof (M6)
# The record is a chain: every line carries the hash of the one before it. This
# verifies the log the boot has just written -- in the image, on the ext2 disk,
# after real tool calls have gone through the sandbox -- and prints the head hash
# so the next boot can tell whether it is looking at the same history.
audit verify
echo boot: origin proof (M7)
# The claim M7 makes is not "there is a flag". It is that the shell KNOWS who
# spoke, and that a model cannot do what a person can. Both halves run here, on
# the real image, through the real shell:
#
#   1. as a HUMAN, `promote` is a command that answers -- an empty stage makes it
#      say so, which is a different outcome from being refused;
#   2. as a MACHINE, the very same word is refused, and the refusal names the
#      origin rather than pretending the command does not exist.
#
# A proof that only ran (2) would pass on a shell where `promote` was deleted.
echo as a human, promote is available:
promote
echo as a machine, promote is not:
machine "promote"
echo boot: aiosh bring-up complete
